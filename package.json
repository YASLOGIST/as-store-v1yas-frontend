{
  "name": "as-store-v1yas-frontend",
  "private": true,
  "sideEffects": false,
  "version": "2026.9.0",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "format": "prettier --write \"app/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"scripts/*.mjs\" \"*.js\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"scripts/*.mjs\" \"*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:install": "node scripts/prepare-chromium.mjs",
    "verify": "npm run check && npx shopify hydrogen build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run format:check && npm run test && npm run audit:security",
    "audit:security": "npm audit --audit-level=high",
    "build:ci": "shopify hydrogen build",
    "check:a11y": "eslint app --no-error-on-unmatched-pattern --max-warnings=0",
    "check:performance": "node scripts/check-bundle.mjs",
    "check:security": "npm run audit:security && vitest run app/lib/http.test.js app/lib/proxy.test.js app/lib/validation.test.js app/tests/storefront-flows.test.js"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "2026.4.5",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "7.18.4",
    "@react-router/fs-routes": "7.18.4",
    "@shopify/cli": "3.85.4",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@sparticuz/chromium": "^141.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "6.4.3",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "lodash": "4.18.1",
    "qs": "6.16.0",
    "ws": "8.22.0",
    "miniflare": {
      "undici": "6.29.0",
      "youch": "3.3.4"
    },
    "@shopify/mini-oxygen": {
      "body-parser": "1.20.8",
      "undici": "7.30.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    }
  }
}
