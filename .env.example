# ------------------------------------------------------------------
# AS Store — environment variables
# Copy to .env and fill in the values from your Shopify admin
# (Shopify admin → Settings → Apps and sales channels → Headless).
# Never commit real tokens.
# ------------------------------------------------------------------

# The domain of your Shopify store (e.g. your-store.myshopify.com)
PUBLIC_STORE_DOMAIN=

# The public Storefront API access token
PUBLIC_STOREFRONT_API_TOKEN=

# The checkout domain (usually the same as PUBLIC_STORE_DOMAIN)
PUBLIC_CHECKOUT_DOMAIN=

# Optional: the Storefront API public ID (used for web pixel analytics)
PUBLIC_STOREFRONT_ID=

# Optional: Customer Account API client ID
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# Optional: session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=
