# ------------------------------------------------------------------
# YAS Store — environment variables
# Copy to .env and fill in the values from your Shopify admin
# (Shopify admin → Settings → Apps and sales channels → Headless).
# Never commit real tokens.
# ------------------------------------------------------------------

# The domain of your Shopify store (e.g. your-store.myshopify.com)
PUBLIC_STORE_DOMAIN=

# The public Storefront API access token
PUBLIC_STOREFRONT_API_TOKEN=

# The checkout domain (usually the same as PUBLIC_STORE_DOMAIN)
PUBLIC_CHECKOUT_DOMAIN=

# Store market used by Storefront/Customer Account APIs (Shopify enum codes).
# Defaults to EN/US when omitted. Examples: AR/AE, FR/CA, PT_BR/BR.
PUBLIC_STORE_LANGUAGE=EN
PUBLIC_STORE_COUNTRY=US

# Optional comma-separated language-country markets shown in the switcher.
# The default language/country above are always retained as an allowed market.
PUBLIC_STORE_MARKETS=EN-US,AR-EG

# Public operational kill switches (true/false). Model viewer remains opt-in.
PUBLIC_FEATURE_PREMIUM_MOTION=true
PUBLIC_FEATURE_POINTER_EFFECTS=true
PUBLIC_FEATURE_PRODUCT_TILT=true
PUBLIC_FEATURE_MODEL_VIEWER=false
PUBLIC_FEATURE_QUICK_VIEW=true
PUBLIC_FEATURE_RECENTLY_VIEWED=true

# Optional: the Storefront API public ID (used for web pixel analytics)
PUBLIC_STOREFRONT_ID=

# Optional: Customer Account API client ID
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# Required: cookie signing secret, minimum 32 characters.
# Generate with: openssl rand -base64 32
# For zero-downtime rotation use: NEW_SECRET,PREVIOUS_SECRET
SESSION_SECRET=
